<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Caller Info Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Caller Image Placeholder -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="Caller"
            android:src="@android:drawable/ic_menu_my_calendar"
            app:tint="@color/white" />

        <!-- Caller Name -->
        <TextView
            android:id="@+id/callerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fake_caller_name"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Incoming Call Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/incoming_call"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- Caller Number -->
        <TextView
            android:id="@+id/callerNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fake_caller_number"
            android:textColor="@color/light_gray"
            android:textSize="16sp" />

        <!-- Mobile Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mobile"
            android:textColor="@color/light_gray"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Call Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="32dp">

        <!-- Decline Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/declineButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:contentDescription="@string/decline"
            android:src="@android:drawable/ic_menu_call"
            app:backgroundTint="@color/error"
            app:tint="@color/white" />

        <!-- Accept Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/acceptButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:contentDescription="@string/accept"
            android:src="@android:drawable/ic_menu_call"
            app:backgroundTint="@color/success"
            app:tint="@color/white" />

    </LinearLayout>

</RelativeLayout>
